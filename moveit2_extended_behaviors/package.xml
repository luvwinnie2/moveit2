<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moveit2_extended_behaviors</name>
  <version>0.1.0</version>
  <description>
    The general-purpose Behaviors: motion, planning scene, waypoints, utilities and the
    user-prompt Behaviors the Studio UI answers.

    Nothing here is robot-specific. A robot's own package supplies the Objectives, the
    configuration and any Behaviors peculiar to its hardware.
  </description>
  <maintainer email="cheesiang_leow@alps-lab.org">Leow Chee Siang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>moveit2_extended_core</depend>
  <depend>moveit2_extended_msgs</depend>
  <depend>behaviortree_cpp_v3</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>pluginlib</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <moveit2_extended_core plugin="${prefix}/behavior_loader_plugin_description.xml"/>
  </export>
</package>
