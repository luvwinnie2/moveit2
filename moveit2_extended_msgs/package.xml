<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moveit2_extended_msgs</name>
  <version>0.1.0</version>
  <description>
    Interfaces for the moveit2-extended Objective/Behavior layer: running an Objective, and
    observing the Behavior Tree while it runs.

    This package deliberately contains no C++ and depends on nothing heavy. An RViz panel, a web
    bridge or a plain rclpy script has to be able to watch an Objective without linking
    BehaviorTree.CPP, MoveIt or pluginlib -- which is exactly what it would have to do if these
    definitions lived next to the server.
  </description>
  <maintainer email="cheesiang_leow@alps-lab.org">Leow Chee Siang</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- Pure IDL, like the rest of these: moveit_msgs is a message package, it does not
       drag MoveIt itself in. The GPU planning service answers with a plain
       moveit_msgs/RobotTrajectory so a GPU plan is a drop-in for an OMPL one. -->
  <depend>moveit_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
