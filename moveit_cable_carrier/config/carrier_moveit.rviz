Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Cable carrier1
      Splitter Ratio: 0.5
    Tree Height: 420
  - Class: rviz_common/Views
    Name: Views
  # NOTE: moveit_rviz_plugin/MotionPlanning is a *Display*, not a Panel. Listing it here makes
  # RViz log "class ... with base class type rviz_common::Panel does not exist". The Display in
  # the section below creates the planning widget on its own, docked, with the Plan/Execute
  # buttons -- that is the MoveIt panel you interact with.
  # Cable-carrier tuning. Edits parameters on carrier_visualizer, so the shape and the verdict
  # update without restarting anything.
  - Class: moveit_cable_carrier/CarrierPanel
    Name: Cable carrier

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Color: 90; 90; 90
      Alpha: 0.35
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.15
      Show Names: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Robot Description: robot_description
      Planning Scene Topic: /monitored_planning_scene
      Planning Request:
        Planning Group: arm
        Show Goal State: true
        Interactive Marker Size: 0.2
        Show Workspace: false
        Query Goal State: true
        Query Start State: false
      Planned Path:
        Loop Animation: true
        Show Trail: false
        State Display Time: 0.05 s
        Trajectory Topic: /display_planned_path
        Show Robot Visual: true
        Show Robot Collision: false
      Scene Geometry:
        Scene Alpha: 0.9
        Show Scene Geometry: true
        Voxel Rendering: Occupied Voxels
      Scene Robot:
        Show Robot Visual: true
        Show Robot Collision: false
        Robot Alpha: 0.5
    - Class: rviz_default_plugins/MarkerArray
      Name: Cable carrier
      Enabled: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /cable_carrier_markers
      Namespaces: {}
  Global Options:
    Background Color: 40; 42; 48
    Fixed Frame: robot_base
    Frame Rate: 30
  Tools:
    # Interact first so it is the active tool on startup. With MoveCamera active the goal-state
    # marker is drawn but every drag just orbits the camera, which looks exactly like "the plugin
    # did not load".
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.8
      Focal Point:
        X: 0.25
        Y: 0
        Z: 0.45
      Pitch: 0.35
      Yaw: 0.9
      Target Frame: robot_base
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  MotionPlanning:
    collapsed: false
  Cable carrier:
    collapsed: false
  Height: 1000
  Width: 1720
